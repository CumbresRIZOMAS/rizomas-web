# Copiar a .env y completar. Nunca versionar .env con valores reales.

# URL base de rizomas-backend (sin /api/v1)
VITE_API_URL=http://localhost:3000

# Supabase Auth (valores públicos: URL del proyecto y anon key)
VITE_SUPABASE_URL=https://<proyecto>.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-supabase-anon-key
