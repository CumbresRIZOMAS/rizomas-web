// Despliegue en Cloudflare Workers (archivos estáticos del build de Vite).
// not_found_handling hace que rutas como /fincas/123 sirvan index.html
// y las resuelva React Router, en vez de responder 404.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rizomas-web",
  "main": "./src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "VITE_API_URL": "https://rizomas-back.onrender.com",
    "VITE_SUPABASE_ANON_KEY": "sb_publishable_7znUNh2oez_xKzXLSldL0w_CJA7iAef",
    "VITE_SUPABASE_URL": "https://jbrslictkcyjwlvzabxo.supabase.co"
  },
  "observability": {
    "logs": {
      "enabled": false,
      "invocation_logs": true
    }
  }
}
